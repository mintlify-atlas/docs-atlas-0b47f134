  "keyFeatures": [
    "End-to-end encryption using libsodium (X25519 ECDH + AES-256-GCM)",
    "Real-time messaging via Socket.io with room-based delivery",
    "WebRTC peer-to-peer audio/video calls with signaling relay",
    "Encrypted media uploads via Cloudinary signed URLs",
    "Temporary Chat mode — messages never persisted to database",
    "Group conversations with per-member wrapped conversation keys",
    "JWT authentication with httpOnly refresh cookie rotation",
    "Pluggable storage via Strategy pattern (Postgres or in-memory)"
  ],
